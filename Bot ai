async def get_mistral_response(session, user_text):
    """محرك الاستجابة الفائق مع دعم الردود الطويلة جداً"""
    url = "https://api.mistral.ai/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {MISTRAL_API_KEY}",
        "Content-Type": "application/json"
    }
    
    for model_name in MODELS:
        data = {
            "model": model_name,
            "messages": [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_text}
            ],
            "temperature": 0.3, # تقليل العشوائية لزيادة الدقة المنطقية في الردود الطويلة
            "max_tokens": 32000 # رفع الحد الأقصى المسموح به تقنياً لضمان عدم انقطاع الإجابة
        }
        try:
            async with session.post(url, json=data, headers=headers, timeout=60) as resp:
                if resp.status == 200:
                    result = await resp.json()
                    return result['choices'][0]['message']['content']
                else:
                    print(f"⚠️ {model_name} استنفد طاقته، أنتقل للنموذج التالي...")
                    continue
        except Exception as e:
            print(f"❌ خطأ تقني: {str(e)}")
            continue
            
    return "خوادم الذكاء الاصطناعي في حالة تحميل قصوى لمعالجة طلبك العبقري، حاول ثانية."

async def send_fb_message(session, recipient_id, text):
    """نظام الإرسال الذكي لتقسيم الردود العملاقة"""
    url = f"https://graph.facebook.com/v19.0/me/messages?access_token={FB_PAGE_ACCESS_TOKEN}"
    # تقسيم النص لضمان توافقه مع واجهة فيسبوك
    parts = [text[i:i+1800] for i in range(0, len(text), 1800)]
    for part in parts:
        payload = {"recipient": {"id": recipient_id}, "message": {"text": part}}
        await session.post(url, json=payload)
        await asyncio.sleep(0.4)

async def handle_request(session, sender_id, text):
    await send_fb_action(session, sender_id, "typing_on")
    reply = await get_mistral_response(session, text)
    await send_fb_message(session, sender_id, reply)
    await send_fb_action(session, sender_id, "typing_off")

async def main_polling():
    global last_seen_message_id
    url = f"https://graph.facebook.com/v19.0/me/conversations?fields=messages{{message,from,id}}&access_token={FB_PAGE_ACCESS_TOKEN}"
    
    async with aiohttp.ClientSession() as session:
        while True:
            try:
                async with session.get(url, timeout=20) as resp:
                    if resp.status == 200:
                        data = await resp.json()
                        if 'data' in data:
                            tasks = []
                            for convo in data['data']:
                                if 'messages' not in convo: continue
                                m = convo['messages']['data'][0]
                                if m['id'] != last_seen_message_id:
                                    tasks.append(asyncio.create_task(handle_request(session, m['from']['id'], m.get('message', ''))))
                                    last_seen_message_id = m['id']
                            if tasks: await asyncio.gather(*tasks)
            except: pass
            await asyncio.sleep(1.2)

def run_async_loop():
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    loop.run_until_complete(main_polling())

if __name__ == "__main__":
    Thread(target=run_async_loop, daemon=True).start()
    port = int(os.environ.get("PORT", 5000))
    web_app.run(host="0.0.0.0", port=port)
