class Storage:
    def __init__(self):
        self.cache={}
        self.redis=None
    async def init(self):
        try:self.redis=await aioredis.from_url(f"redis://{REDIS_HOST}:{REDIS_PORT}/0",max_connections=100)
        except:logger.warning("Redis غير متوفر")
    async def get_conv(self,uid):
        if uid in self.cache:return self.cache[uid]
        if self.redis:
            try:
                data=await self.redis.get(f"u:{uid}")
                if data:self.cache[uid]=json.loads(data);return self.cache[uid]
            except:pass
        return []
    async def save_conv(self,uid,msgs):
        self.cache[uid]=msgs
        if self.redis:
            try:await self.redis.setex(f"u:{uid}",3600,json.dumps(msgs))
            except:pass
    async def is_processed(self,mid):
        if self.redis:return await self.redis.sismember("p",mid)
        return False
    async def mark_processed(self,mid):
        if self.redis:
            try:await self.redis.sadd("p",mid);await self.redis.expire("p",86400)
            except:pass
