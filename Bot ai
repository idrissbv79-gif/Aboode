async def split_send(uid,msg):
    if len(msg)<=CHUNK:await send_fb(uid,msg);return
    parts=[msg[i:i+CHUNK] for i in range(0,len(msg),CHUNK)]
    for i,p in enumerate(parts,1):
        await send_fb(uid,f"[{i}/{len(parts)}]\n{p}")
        await asyncio.sleep(0.5)

