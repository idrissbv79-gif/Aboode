class Poller:
    def __init__(self):
        self.running=True;self.last=int(time.time());self.q=Queue()
    async def poll(self):
        while self.running:
            try:
                url=f"https://graph.facebook.com/v11.0/me/conversations?fields=messages.limit(50){{message,from,id}}&since={self.last}&access_token={FACEBOOK_TOKEN}"
                async with sessions.get("poll").get(url) as r:
                    if r.status==200:
                        for conv in (await r.json()).get('data',[]):
                            for msg in conv.get('messages',{}).get('data',[]):
                                if await storage.is_processed(msg['id']):continue
                                sid=msg['from']['id'];cont=msg.get('message',{})
                                if isinstance(cont,str):cont={'text':cont}
                                await self.q.put((sid,cont));await storage.mark_processed(msg['id'])
                        self.last=int(time.time())
                    elif r.status==429:await asyncio.sleep(int(r.headers.get('Retry-After',60)))
                    else:await asyncio.sleep(5)
                await asyncio.sleep(0.2)
            except Exception as e:logger.error(f"Poll:{e}");await asyncio.sleep(3)
    async def process(self):
        while self.running:
            batch=[]
            try:
                while len(batch)<1000:
                    batch.append(await asyncio.wait_for(self.q.get(),0.01))
            except:pass
            if batch:await asyncio.gather(*[handle_msg(uid,msg) for uid,msg in batch])
            await asyncio.sleep(0.1)
    async def monitor(self):
        while self.running:
            logger.info(f"📊 ذاكرة:{psutil.Process().memory_percent():.1f}% CPU:{psutil.Process().cpu_percent():.1f}%")
            await asyncio.sleep(5)
    async def start(self):
        await storage.init();await get_token()
        asyncio.create_task(self.poll());asyncio.create_task(self.process());asyncio.create_task(self.monitor())
        while self.running:await asyncio.sleep(1)

async def main():
    p=Poller();await p.start()
