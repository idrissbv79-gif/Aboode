@app.route('/webhook', methods=['GET'])
def verify():
    # التحقق من الويب هوك عند الإعداد لأول مرة في فيسبوك
    mode = request.args.get('hub.mode')
    token = request.args.get('hub.verify_token')
    challenge = request.args.get('hub.challenge')
    
    if mode == 'subscribe' and token == aetheris.VERIFY_TOKEN:
        logging.info("✅ Webhook Verified Successfully!")
        return challenge, 200
    return "Verification Failed", 403

@app.route('/webhook', methods=['POST'])
def webhook():
    # استقبال الرسائل الفعلية
    data = request.get_json()
    if data.get('object') == 'page':
        for entry in data.get('entry', []):
            for messaging_event in entry.get('messaging', []):
                if messaging_event.get('message'):
                    sender_id = messaging_event['sender']['id']
                    text = messaging_event['message'].get('text')
                    
                    if text:
                        # تشغيل المعالجة في الخلفية لعدم تأخير سيرفر فيسبوك
                        aetheris.executor.submit(aetheris.handle_request, sender_id, text)
        return "EVENT_RECEIVED", 200
    return "Not Found", 404

