async def get_mistral_response(session, user_text, sender_id):
    url = "https://api.mistral.ai/v1/chat/completions"
    headers = {"Authorization": f"Bearer {MISTRAL_API_KEY}", "Content-Type": "application/json"}
    
    # جلب النموذج المختار أو الافتراضي
    chosen_model = user_preferences.get(sender_id, "mistral-large-latest")
    
    data = {
        "model": chosen_model,
        "messages": [{"role": "system", "content": SYSTEM_PROMPT}, {"role": "user", "content": user_text}],
        "temperature": 0.4
    }
    try:
        async with session.post(url, json=data, headers=headers, timeout=50) as resp:
            if resp.status == 200:
                result = await resp.json()
                return result['choices'][0]['message']['content']
            return "⚠️ خوادم Mistral لا تستجيب حالياً."
    except:
        return "❌ حدث خطأ تقني في المعالجة."

async def handle_request(session, sender_id, text):
    """المعالج الذكي للرسائل والأرقام"""
    text_clean = text.strip()

    # 1. إذا طلب المستخدم القائمة
    if text_clean.lower() == "/model":
        models_text = "🤖 قائمة نماذج Teamily المتاحة:\n\n"
        for i, model in enumerate(AVAILABLE_MODELS, 1):
            models_text += f"{i}. {model}\n"
        models_text += "\n🔢 أرسل رقم النموذج (مثلاً 1) لتفعيله فوراً."
        
        waiting_for_model_selection[sender_id] = True # تفعيل حالة انتظار الرقم
        await send_fb_message(session, sender_id, models_text)
        return

    # 2. إذا كان البوت ينتظر رقماً من هذا المستخدم
    if waiting_for_model_selection.get(sender_id) and text_clean.isdigit():
        index = int(text_clean) - 1
        if 0 <= index < len(AVAILABLE_MODELS):
            selected = AVAILABLE_MODELS[index]
            user_preferences[sender_id] = selected
            waiting_for_model_selection[sender_id] = False # إيقاف حالة الانتظار
            await send_fb_message(session, sender_id, f"✅ ممتاز! تم تفعيل النموذج الذكي: {selected}\nأنا جاهز لأسئلتك الآن.")
        else:
            await send_fb_message(session, sender_id, "❌ الرقم غير موجود في القائمة. اختر من 1 إلى 8.")
        return

    # 3. الرد العادي بالنموذج المختار سابقاً
    waiting_for_model_selection[sender_id] = False # إلغاء حالة الانتظار إذا أرسل نصاً عادياً
    reply = await get_mistral_response(session, text, sender_id)
    await send_fb_message(session, sender_id, reply)

async def main_polling():
    global last_seen_message_id
    url = f"https://graph.facebook.com/v19.0/me/conversations?fields=messages{{message,from,id}}&access_token={FB_PAGE_ACCESS_TOKEN}"
    async with aiohttp.ClientSession() as session:
        while True:
            try:
                async with session.get(url, timeout=15) as resp:
                    if resp.status == 200:
                        data = await resp.json()
                        if 'data' in data:
                            for convo in data['data']:
                                if 'messages' not in convo: continue
                                m = convo['messages']['data'][0]
                                if m['id'] != last_seen_message_id:
                                    asyncio.create_task(handle_request(session, m['from']['id'], m.get('message', '')))
                                    last_seen_message_id = m['id']
            except: pass
            await asyncio.sleep(1.2)

if __name__ == "__main__":
    Thread(target=lambda: asyncio.run(main_polling()), daemon=True).start()
    web_app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000)))
