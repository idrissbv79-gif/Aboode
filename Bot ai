class RateLimiter:
    def __init__(self):self.reqs={}
    def allow(self,uid):
        now=time.time();self.reqs[uid]=[t for t in self.reqs.get(uid,[]) if now-t<60]
        if len(self.reqs.get(uid,[]))>=10000:return False
        self.reqs.setdefault(uid,[]).append(now);return True
