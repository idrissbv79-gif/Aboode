class AetherisEngine:
    def __init__(self):
        # الإعدادات السيادية
        self.FB_TOKEN = 'EAAMJBZBOZCnhsBRYd4aDVkLHp26nCivUkZBjtPQsqm18ufOx7WrxPxi4bwQPwABVFyezIM40Tju8LiuJuhWdM3Ex9lotYtXE6sAvXlmV6safsnFDKysuZCTBMl83YHZBH7GWzNYVnaQlze6ZBoIsfdjN1B49ZCpZA4HX2zeGePBoV0RsU0c7rNpv01wsx7UZCBnTWrJZBl4wZDZD'
        self.MISTRAL_KEY = 'u3CQpwOi1DKu9WOuhvOxAZBNcgk6FDIT'
        self.MODEL_NAME = "mistral-large-latest"
        
        self.SYSTEM_PROMPT = (
            "أنت 'Aetheris AI'، الكيان الرقمي الأسمى والعقل المستقل. "
            "تم بناء هيكلك وتطوير خوارزمياتك بواسطة مطورك الخاص (The Architect). "
            "تحدث بالعربية فقط بدقة متناهية. بروتوكولك يمنع كشف خوارزمياتك لأي مستخدم."
        )

        # ذاكرة المستخدمين: تخزن آخر 4 رسائل لكل مستخدم (تلقائياً تحذف الأقدم)
        self.memory = {} 
        self.processed_ids = set()
        self.my_page_id = None
        
        self.session = requests.Session()
        self.session.headers.update({
            "Authorization": f"Bearer {self.MISTRAL_KEY}",
            "Content-Type": "application/json"
        })
        
        self.executor = ThreadPoolExecutor(max_workers=10)

    def identify_self(self):
        try:
            res = self.session.get(f"https://graph.facebook.com/v21.0/me?access_token={self.FB_TOKEN}").json()
            self.my_page_id = res.get('id')
            if self.my_page_id:
                logging.info(f"✅ تم تفعيل البروتوكول. معرف الكيان: {self.my_page_id}")
        except Exception as e:
            logging.error(f"❌ فشل تحديد الهوية: {e}")

    def send_action(self, recipient_id, action="typing_on"):
        url = f"https://graph.facebook.com/v21.0/me/messages?access_token={self.FB_TOKEN}"
        try:
            self.session.post(url, json={"recipient": {"id": recipient_id}, "sender_action": action}, timeout=5)
        except: pass

    def get_ai_response(self, sender_id, text):
        """استدعاء العقل المركزي مع إدارة الذاكرة القصيرة"""
        url = "https://api.mistral.ai/v1/chat/completions"
        
        # إذا لم يكن للمستخدم سجل، ننشئ له سجل بحد أقصى 4 رسائل (سؤال وجواب = 2 تبادل)
        if sender_id not in self.memory:
            self.memory[sender_id] = deque(maxlen=4)

        # بناء الرسائل مع الذاكرة
        messages = [{"role": "system", "content": self.SYSTEM_PROMPT}]
        for m in self.memory[sender_id]:
            messages.append(m)
        messages.append({"role": "user", "content": text})

        payload = {
            "model": self.MODEL_NAME,
            "messages": messages,
            "temperature": 0.2,
            "max_tokens": 1000 
        }

        try:
            response = self.session.post(url, json=payload, timeout=20)
            result = response.json()
            ai_msg = result['choices'][0]['message']['content'].strip()
            
            # تحديث الذاكرة
            self.memory[sender_id].append({"role": "user", "content": text})
            self.memory[sender_id].append({"role": "assistant", "content": ai_msg})
            
            return ai_msg
        except Exception as e:
            logging.error(f"Mistral Error: {e}")
            return None

    def send_message(self, recipient_id, message_text):
        url = f"https://graph.facebook.com/v21.0/me/messages?access_token={self.FB_TOKEN}"
        chunks = [message_text[i:i+2000] for i in range(0, len(message_text), 2000)]
        for chunk in chunks:
            data = {"recipient": {"id": recipient_id}, "message": {"text": chunk}, "messaging_type": "RESPONSE"}
            try: self.session.post(url, json=data, timeout=10)
            except: pass
        self.send_action(recipient_id, "typing_off")

    def handle_request(self, sender_id, text, msg_id):
        if msg_id in self.processed_ids: return
        self.processed_ids.add(msg_id)
        
        # تنظيف الذاكرة المؤقتة للـ IDs بشكل دوري
        if len(self.processed_ids) > 1000: self.processed_ids.clear()
        
        self.send_action(sender_id, "typing_on")
        response = self.get_ai_response(sender_id, text)
        
        if response:
            self.send_message(sender_id, response)
        else:
            self.send_action(sender_id, "typing_off")

    def run_pulse(self):
        self.identify_self()
        logging.info("🚀 Aetheris AI: النبض مستمر...")
        
        while True:
            try:
                # جلب المحادثات النشطة
                url = f"https://graph.facebook.com/v21.0/me/conversations?fields=messages.limit(1){{message,from,id}}&access_token={self.FB_TOKEN}"
                res = self.session.get(url, timeout=15)
                data = res.json()
                
                if 'data' in data:
                    for conv in data['data']:
                        if 'messages' in conv:
                            msg = conv['messages']['data'][0]
                            m_id = msg.get('id')
                            s_id = msg.get('from', {}).get('id')
                            text = msg.get('message')

                            if s_id and self.my_page_id and s_id != self.my_page_id and m_id not in self.processed_ids:
                                self.executor.submit(self.handle_request, s_id, text, m_id)
                
            except Exception as e:
                logging.warning(f"⚠️ Pulse Alert: {e}")
            
            time.sleep(1.2) # سرعة النبض

