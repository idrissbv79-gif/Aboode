async def send_fb_action(session, recipient_id, action="typing_on"):
    """إرسال 'جاري الكتابة' بشكل غير متزامن"""
    url = f"https://graph.facebook.com/v19.0/me/messages?access_token={FB_PAGE_ACCESS_TOKEN}"
    try:
        await session.post(url, json={"recipient": {"id": recipient_id}, "sender_action": action})
    except: pass

async def get_mistral_response(session, user_text):
    """جلب رد ميسترال بسرعة فائقة عبر aiohttp"""
    url = "https://api.mistral.ai/v1/chat/completions"
    headers = {"Authorization": f"Bearer {MISTRAL_API_KEY}", "Content-Type": "application/json"}
    data = {
        "model": MISTRAL_MODEL,
        "messages": [{"role": "system", "content": SYSTEM_PROMPT}, {"role": "user", "content": user_text}],
        "temperature": 0.3
    }
    try:
        async with session.post(url, json=data, headers=headers, timeout=40) as resp:
            res_json = await resp.json()
            return res_json['choices'][0]['message']['content']
    except:
        return "خوادم Teamily في أقصى طاقتها، سأرد فوراً."

async def send_fb_message(session, recipient_id, text):
    """إرسال الرسالة المقسمة دون تعطيل البوت"""
    url = f"https://graph.facebook.com/v19.0/me/messages?access_token={FB_PAGE_ACCESS_TOKEN}"
    # تقسيم النص إذا كان طويلاً
    limit = 1800
    parts = [text[i:i+limit] for i in range(0, len(text), limit)]
    
    for part in parts:
        await session.post(url, json={"recipient": {"id": recipient_id}, "message": {"text": part}})

async def handle_user_request(session, sender_id, text):
    """معالجة كل مستخدم في 'خيط' وهمي مستقل تماماً"""
    await send_fb_action(session, sender_id, "typing_on")
    reply = await get_mistral_response(session, text)
    await send_fb_message(session, sender_id, reply)
    await send_fb_action(session, sender_id, "typing_off")

async def poll_messages():
    """نظام السحب العملاق (Async Polling)"""
    global last_seen_message_id
    url = f"https://graph.facebook.com/v19.0/me/conversations?fields=messages{{message,from,id}}&access_token={FB_PAGE_ACCESS_TOKEN}"
    
    async with aiohttp.ClientSession() as session:
        while True:
            try:
                async with session.get(url, timeout=10) as resp:
                    data = await resp.json()
                    if 'data' in data and data['data']:
                        # معالجة كافة المحادثات الجديدة بالتوازي
                        tasks = []
                        for convo in data['data']:
                            latest_msg = convo['messages']['data'][0]
                            msg_id = latest_msg['id']
                            sender_id = latest_msg['from']['id']
                            text = latest_msg.get('message', '')

                            if msg_id != last_seen_message_id and text:
                                # بدء معالجة هذا المستخدم فوراً دون انتظار الآخرين
                                tasks.append(asyncio.create_task(handle_user_request(session, sender_id, text)))
                                last_seen_message_id = msg_id
                        
                        if tasks:
                            await asyncio.gather(*tasks) # تشغيل كل المهام معاً
            except Exception as e:
                print(f"Error: {e}")
            
            await asyncio.sleep(1) # سرعة فحص هائلة (ثانية واحدة)

if __name__ == "__main__":
    print("🔥 Teamily Mega-Parallel System is LIVE...")
    asyncio.run(poll_messages())
