async def send_fb_message(session, recipient_id, text):
    url = f"https://graph.facebook.com/v19.0/me/messages?access_token={FB_PAGE_ACCESS_TOKEN}"
    parts = [text[i:i+1800] for i in range(0, len(text), 1800)]
