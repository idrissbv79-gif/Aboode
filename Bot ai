# --- وظائف البوت ---
async def send_fb_action(session, recipient_id, action="typing_on"):
    url = f"https://graph.facebook.com/v19.0/me/messages?access_token={FB_PAGE_ACCESS_TOKEN}"
    try: await session.post(url, json={"recipient": {"id": recipient_id}, "sender_action": action})
    except: pass

async def get_mistral_response(session, user_text):
    url = "https://api.mistral.ai/v1/chat/completions"
    headers = {"Authorization": f"Bearer {MISTRAL_API_KEY}"}
    data = {"model": MISTRAL_MODEL, "messages": [{"role": "system", "content": SYSTEM_PROMPT}, {"role": "user", "content": user_text}]}
    try:
        async with session.post(url, json=data, headers=headers) as resp:
            res = await resp.json()
            return res['choices'][0]['message']['content']
    except: return "سأرد عليك حالاً..."

async def send_fb_message(session, recipient_id, text):
    url = f"https://graph.facebook.com/v19.0/me/messages?access_token={FB_PAGE_ACCESS_TOKEN}"
    parts = [text[i:i+1800] for i in range(0, len(text), 1800)]
    for part in parts:
        await session.post(url, json={"recipient": {"id": recipient_id}, "message": {"text": part}})

async def handle_request(session, sender_id, text):
    await send_fb_action(session, sender_id, "typing_on")
    reply = await get_mistral_response(session, text)
    await send_fb_message(session, sender_id, reply)
    await send_fb_action(session, sender_id, "typing_off")

async def main_polling():
    global last_seen_message_id
    url = f"https://graph.facebook.com/v19.0/me/conversations?fields=messages{{message,from,id}}&access_token={FB_PAGE_ACCESS_TOKEN}"
    async with aiohttp.ClientSession() as session:
        while True:
            try:
                async with session.get(url) as resp:
                    data = await resp.json()
                    if 'data' in data:
                        tasks = []
                        for convo in data['data']:
                            m = convo['messages']['data'][0]
                            if m['id'] != last_seen_message_id:
                                tasks.append(asyncio.create_task(handle_request(session, m['from']['id'], m.get('message', ''))))
                                last_seen_message_id = m['id']
                        if tasks: await asyncio.gather(*tasks)
            except: pass
            await asyncio.sleep(2)

def run_async_loop():
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    loop.run_until_complete(main_polling())

if __name__ == "__main__":
    # تشغيل البولينج في خيط منفصل وتشغيل خادم الويب
    Thread(target=run_async_loop).start()
    web_app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000)))
