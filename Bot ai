                                self.processed_ids.add(m_id)
                                if len(self.processed_ids) > 1000: self.processed_ids.clear()
                                # تنفيذ فوري في خيط منفصل تماماً عن النبض
                                self.executor.submit(self.handle_request, s_id, text, m_id)
            except: pass
            time.sleep(0.8) # تسريع النبض ليكون أكثر استجابة

