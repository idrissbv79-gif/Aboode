    def identify_self(self):
        """التحقق من الهوية الرقمية لتجنب الرد الذاتي"""
        try:
            res = self.session.get(f"https://graph.facebook.com/v21.0/me?access_token={self.FB_TOKEN}").json()
            self.my_page_id = res.get('id')
            if self.my_page_id:
                logging.info(f"✅ تم تفعيل بروتوكول Aetheris. الهوية المستقرة: {self.my_page_id}")
        except Exception as e:
            logging.error(f"❌ فشل في مصادقة النظام: {e}")

    def send_action(self, recipient_id, action="typing_on"):
        """إدارة ميزات التفاعل (جاري الكتابة)"""
        url = f"https://graph.facebook.com/v21.0/me/messages?access_token={self.FB_TOKEN}"
        try:
            self.session.post(url, json={"recipient": {"id": recipient_id}, "sender_action": action})
        except: pass

    def get_ai_response(self, text):
        """استدعاء العقل المركزي لـ Aetheris"""
        url = "https://api.mistral.ai/v1/chat/completions"
        payload = {
            "model": self.MODEL_NAME,
            "messages": [
                {"role": "system", "content": self.SYSTEM_PROMPT},
                {"role": "user", "content": text}
            ],
            "temperature": 0.2,
            "max_tokens": 2000 
        }
        try:
            response = self.session.post(url, json=payload, timeout=15)
            result = response.json()
            return result['choices'][0]['message']['content'].strip()
        except:
            return None

    def send_message(self, recipient_id, message_text):
        """إرسال الرد وتجزئته وتأمين النظافة اللغوية"""
        self.send_action(recipient_id, "typing_off")
        url = f"https://graph.facebook.com/v21.0/me/messages?access_token={self.FB_TOKEN}"
        chunks = [message_text[i:i+2000] for i in range(0, len(message_text), 2000)]
        for chunk in chunks:
            data = {"recipient": {"id": recipient_id}, "message": {"text": chunk}, "messaging_type": "RESPONSE"}
            try: self.session.post(url, json=data)
            except: pass

    def handle_request(self, sender_id, text, msg_id):
        """معالجة الطلب بذكاء وتأمين الرد على كل رسالة"""
        if msg_id in self.processed_ids: return
        self.processed_ids.add(msg_id)
        
        # تنظيف الذاكرة المؤقتة دورياً
        if len(self.processed_ids) > 1000: self.processed_ids.clear()
        
        self.send_action(sender_id, "typing_on")
        response = self.get_ai_response(text)
        
        if response:
            self.send_message(sender_id, response)
        else:
            self.send_action(sender_id, "typing_off")

    def run_pulse(self):
        """نبض النظام - يفحص الرسائل كل ثانية لضمان الاستجابة الفورية"""
        self.identify_self()
        while True:
            try:
                # جلب آخر المحادثات مع الرسالة الأخيرة لكل منها
                url = f"https://graph.facebook.com/v21.0/me/conversations?fields=messages.limit(1){{message,from,id}}&access_token={self.FB_TOKEN}"
                data = self.session.get(url).json()
                
                if 'data' in data:
                    for conv in data['data']:
                        if 'messages' in conv:
                            msg = conv['messages']['data'][0]
                            m_id = msg.get('id')
                            s_id = msg.get('from', {}).get('id')
                            text = msg.get('message')

                            # التأكد من أن الرسالة من المستخدم وليست من البوت، ولم يتم معالجتها
                            if s_id and s_id != self.my_page_id and m_id not in self.processed_ids:
                                self.executor.submit(self.handle_request, s_id, text, m_id)
            except Exception as e:
                logging.warning(f"⚠️ تنبيه نظام: {e}")
            
            # معدل الفحص: ثانية واحدة لضمان أعلى سرعة رد دون تعليق السيرفر
            time.sleep(1.0) 

