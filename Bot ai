class SessionManager:
    def __init__(self):
        self.sessions={}
        self.sem=Semaphore(MAX_TASKS)
    def get(self,n='default'):
        if n not in self.sessions:
            conn=TCPConnector(limit=MAX_CONN,ttl_dns_cache=300,ssl=False)
            self.sessions[n]=aiohttp.ClientSession(connector=conn,timeout=ClientTimeout(total=TIMEOUT))
        return self.sessions[n]
    async def close(self):
        for s in self.sessions.values():await s.close()
